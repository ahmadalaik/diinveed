enum RsvpResponse {
    ACCEPT
    DECLINE
    MAYBE
}

enum WishModerationStatus {
    PENDING
    APPROVED
    HIDDEN
}

model Invitation {
    id          String @id @default(cuid())
    userId      String @unique @map("user_id")
    slug        String @default("") @map("slug")
    publicToken String @unique @map("public_token")

    title                String  @default("")
    coverDesktopImage    String? @map("cover_desktop_image")
    coverDesktopImageKey String? @map("cover_desktop_image_key")
    coverMobileImage     String? @map("cover_mobile_image")
    coverMobileImageKey  String? @map("cover_mobile_image_key")
    music                String  @default("")
    musicKey             String  @default("") @map("music_key")

    quote          String @default("")
    quoteReference String @default("")

    isBrideFirst     Boolean @default(true) @map("is_bride_first")
    brideName        String  @default("") @map("bride_name")
    brideNickname    String  @default("") @map("bride_nickname")
    brideDescription String? @map("bride_description")
    brideImage       String? @map("bride_image")
    brideImageKey    String? @map("bride_image_key")
    groomName        String  @default("") @map("groom_name")
    groomNickname    String  @default("") @map("groom_nickname")
    groomDescription String? @map("groom_description")
    groomImage       String? @map("groom_image")
    groomImageKey    String? @map("groom_image_key")

    events Json
    stories   Json
    gallery   Json
    gifts   Json

    rsvpDeadline  String @default("") @map("rsvp_deadline")
    rsvpOptions   Json   @map("rsvp_options")
    wishesOptions Json?  @map("wishes_options")

    tokenOverrides Json?  @map("token_overrides")
    templateSlug   String @default("kelana") @map("template_slug")
    backgroundType String @default("solid") @map("background_type")

    isPublished Boolean  @default(false) @map("is_published")
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    user             User              @relation(fields: [userId], references: [id])
    guestRsvps       GuestRsvp[]
    guests           Guest[]
    messageTemplates MessageTemplate[]
    draft            InvitationDraft?

    @@map("invitations")
}

model InvitationDraft {
    id                    String   @id @default(cuid())
    invitationId          String   @unique @map("invitation_id")
    data                  Json
    hasUnpublishedChanges Boolean  @default(false) @map("has_unpublished_changes")
    createdAt             DateTime @default(now()) @map("created_at")
    updatedAt             DateTime @updatedAt @map("updated_at")

    invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

    @@map("invitation_drafts")
}

model GuestRsvp {
    id               String               @id @default(cuid())
    invitationId     String               @map("invitation_id")
    name             String
    phoneNumber      String?
    response         RsvpResponse
    guests           Int                  @default(1)
    wish             String?              @db.Text
    moderationStatus WishModerationStatus @default(APPROVED) @map("moderation_status")
    createdAt        DateTime             @default(now()) @map("created_at")
    updatedAt        DateTime             @updatedAt @map("updated_at")
    guestId          String?              @map("guest_id")

    invitation Invitation @relation(fields: [invitationId], references: [id])
    guest      Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)

    @@index([invitationId])
    @@index([guestId])
    @@map("guest_rsvps")
}

model Guest {
    id           String    @id @default(cuid())
    invitationId String    @map("invitation_id")
    slug         String
    name         String
    phoneNumber  String?   @map("phone_number")
    invitedCount Int       @default(1) @map("invited_count")
    category     String?   @map("category")
    sentAt       DateTime? @map("sent_at")
    createdAt    DateTime  @default(now()) @map("created_at")
    updatedAt    DateTime  @updatedAt @map("updated_at")

    invitation Invitation  @relation(fields: [invitationId], references: [id], onDelete: Cascade)
    rsvps      GuestRsvp[]

    @@unique([invitationId, slug])
    @@index([invitationId])
    @@map("guests")
}

model MessageTemplate {
    id           String   @id @default(cuid())
    invitationId String   @map("invitation_id")
    title        String
    body         String   @db.Text
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

    @@index([invitationId])
    @@map("message_templates")
}
